# One-Minute Docs backend configuration. Copy to .env for local development; use a secret manager in production.
NODE_ENV=development
# api | worker | all (api + worker in one process; fine for development and small deployments)
ROLE=all
PORT=8080
LOG_LEVEL=info
# Set to true when running behind a reverse proxy / load balancer so client IPs are correct for rate limiting.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Empty = no browser access (the Android app does not need CORS).
CORS_ORIGINS=

DATABASE_URL=postgres://omd:omd@localhost:5432/omd
REDIS_URL=redis://localhost:6379/0

# REQUIRED: at least 32 random characters, e.g. `openssl rand -base64 48`. Rotating it invalidates all client tokens
# (apps transparently fetch a new one).
TOKEN_SECRET=
TOKEN_TTL_DAYS=30

# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-data
# S3-compatible storage (private bucket; add a lifecycle rule deleting objects after 1 day as a backstop)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
WORK_DIR=/tmp/omd-work

# Fair-use and resource limits (shown to users via GET /api/v1/capabilities)
MAX_UPLOAD_MB=50
MAX_FILES_PER_JOB=20
MAX_PAGES=300
JOB_TIMEOUT_SECONDS=180
WORKER_CONCURRENCY=2
OUTPUT_TTL_MINUTES=60
RATE_TOKENS_PER_IP_HOUR=20
RATE_JOBS_PER_CLIENT_HOUR=30
AI_REQUESTS_PER_CLIENT_DAY=50
HANDWRITING_PAGES_PER_CLIENT_DAY=60

# AI provider: anthropic | none. Without credentials AI endpoints return 503 AI_NOT_CONFIGURED.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_REFUSAL_FALLBACK=true
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=8000
AI_TIMEOUT_SECONDS=120

# PDF -> Word engine: pdf2docx (best quality; PyMuPDF is AGPL-3.0 or commercial) | libreoffice (MPL-2.0, text boxes).
# Required in production. See docs/DEPENDENCY_REGISTER.md before choosing.
PDF_TO_DOCX_ENGINE=

# Engine binaries (defaults assume PATH)
SOFFICE_BIN=soffice
TESSERACT_BIN=tesseract
PDFTOPPM_BIN=pdftoppm
PDFTOTEXT_BIN=pdftotext
QPDF_BIN=qpdf
GS_BIN=gs
PYTHON_BIN=python3
